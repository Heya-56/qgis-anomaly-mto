{
  // Configuration Cloudflare du site Atlas Pacifica
  "name": "qgis-anomaly-mto",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  // Limitation de débit des routes /api/ : 60 requêtes par minute et par adresse IP
  "ratelimits": [
    { "name": "LIMITEUR", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
